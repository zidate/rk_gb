     return ret;
 }
 
+static int prepare_ubi_partition(const char *partition_name) {
+    const MtdPartition *partition;
+    struct ubi_attach_req request;
+    int control_fd = -1;
+    int ubi_num;
+    int ret = -1;
+
+    if (mtd_scan_partitions() < 0) {
+        LOGE("Scan MTD partitions before UBI attach failed.\n");
+        return -1;
+    }
+    partition = mtd_find_partition_by_name(partition_name);
+    if (!partition) {
+        LOGE("Can't find UBI MTD partition %s.\n", partition_name);
+        return -1;
+    }
+
+    control_fd = open("/dev/ubi_ctrl", O_RDWR);
+    if (control_fd < 0) {
+        LOGE("Open /dev/ubi_ctrl failed.\n");
+        return -1;
+    }
+
+    memset(&request, 0, sizeof(request));
+    request.ubi_num = UBI_DEV_NUM_AUTO;
+    request.mtd_num = partition->device_index;
+    if (ioctl(control_fd, UBI_IOCATT, &request) < 0) {
+        LOGE("Attach UBI partition %s failed.\n", partition_name);
+        goto out;
+    }
+
+    ubi_num = request.ubi_num;
+    if (ioctl(control_fd, UBI_IOCDET, &ubi_num) < 0) {
+        LOGE("Detach UBI partition %s failed.\n", partition_name);
+        goto out;
+    }
+
+    LOGI("Initialized UBI partition %s before restoring protection.\n",
+         partition_name);
+    ret = 0;
+
+out:
+    close(control_fd);
+    return ret;
+}
