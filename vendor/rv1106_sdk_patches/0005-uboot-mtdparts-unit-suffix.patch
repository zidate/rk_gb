 	} else {
-		partition->size = ustrtoull(mtdparts, (char **)&mtdparts, 0);
+		partition->size = mtd_memsize_parse(mtdparts, &mtdparts);
 		if (partition->size < SZ_4K) {
 			printf("Minimum partition size 4kiB, %lldB requested\n",
 			       partition->size);
